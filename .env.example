# Local preview is the default. Never put this file's real secrets in version control.
PORT=4173
HOST=127.0.0.1
SITE_ORIGIN=http://127.0.0.1:4173
APP_MODE=demo
MAIL_MODE=preview
# Configure only after choosing the approved email processor and verifying the sender domain.
TEST_EMAIL=
MAIL_FROM=
RESEND_API_KEY=
# Generate a 32-byte encryption key for staging/live; keep it separately from backups.
DATA_KEY=
# Live mode additionally requires approval of privacy, retention, hosting and clinical copy.
LAUNCH_APPROVED=no
RETENTION_DAYS=7
# Use a persistent private directory when hosted; keep demo and live databases separate.
# DATA_DIR=/var/lib/moston
